{
  "name": "clothing-simulation",
  "version": "1.0.0",
  "description": "내 옷으로 상의·하의 조합을 만들어 룩북에 저장하는 Electron 앱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^35.1.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "heic-convert": "^2.1.0",
    "sharp": "^0.32.6"
  },
  "build": {
    "appId": "com.haeji.clothing-simulation",
    "productName": "Clothing Simulation",
    "npmRebuild": false,
    "afterPack": "./afterPack.js",
    "files": [
      "**/*",
      "!wardrobe/**",
      "!dist/**",
      "!*.icns",
      "!*.ico"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/@imgly/**"
    ],
    "mac": {
      "target": "zip",
      "icon": "icon.icns",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  }
}
